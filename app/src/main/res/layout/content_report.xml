<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs_report"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabIndicatorColor="@color/bc_primary"
        app:tabSelectedTextColor="@color/bc_primary"
        app:tabTextColor="@color/bc_text_secondary">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/report_tab_daily" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/report_tab_weekly" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/report_tab_monthly" />
    </com.google.android.material.tabs.TabLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ===== Daily ===== -->
            <LinearLayout
                android:id="@+id/section_daily"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/report_today_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/text_today_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:padding="16dp"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ===== Weekly ===== -->
            <LinearLayout
                android:id="@+id/section_weekly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/report_calories_week"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/chart_calories_week"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_margin="12dp" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/report_water_week"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/chart_water_week"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_margin="12dp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ===== Monthly ===== -->
            <LinearLayout
                android:id="@+id/section_monthly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/report_calories_month"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/chart_calories_month"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_margin="12dp" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/report_weight_trend"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/chart_weight"
                            android:layout_width="match_parent"
                            android:layout_height="220dp"
                            android:layout_margin="12dp" />

                        <TextView
                            android:id="@+id/text_no_weight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp"
                            android:text="@string/report_no_weight"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/bc_text_secondary"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share_sms"
                style="@style/Widget.Material3.Button.Icon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/action_share_sms"
                app:icon="@drawable/ic_chat" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
