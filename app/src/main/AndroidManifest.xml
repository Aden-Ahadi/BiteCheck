<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network access for Supabase and the Food Advisor -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Daily reminder notifications (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Share daily summary via SMS -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Smart-scale pairing (API 31+ uses BLUETOOTH_CONNECT; older use BLUETOOTH) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <!-- Exact alarms for the daily reminder (Demo precision) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Package visibility (API 30+): let the Food Advisor find a camera app -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".BiteCheckApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BiteCheck">

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.BiteCheck.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep link for Password Reset -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="reset-password"
                    android:scheme="bitecheck" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.UpdatePasswordActivity" android:exported="false" />

        <!-- Auth & onboarding -->
        <activity
            android:name=".ui.IntroActivity"
            android:exported="false"
            android:theme="@style/Theme.BiteCheck.Intro" />
        <activity
            android:name=".ui.WelcomeActivity"
            android:exported="false"
            android:theme="@style/Theme.BiteCheck.Light" />
        <activity
            android:name=".ui.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.BiteCheck.Light"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.SignUpActivity"
            android:exported="false"
            android:theme="@style/Theme.BiteCheck.Light"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.ResetPasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.BiteCheck.Light"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main tabs -->
        <activity android:name=".ui.DashboardActivity" android:exported="false" />
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.FoodAdvisorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.MealHistoryActivity" android:exported="false" />

        <!-- Secondary screens -->
        <activity android:name=".ui.WaterTrackerActivity" android:exported="false" />
        <activity android:name=".ui.WeightTrackerActivity" android:exported="false" />
        <activity android:name=".ui.ReportActivity" android:exported="false" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.AccountActivity" android:exported="false" />
        <activity android:name=".ui.UserFeedbackActivity" android:exported="false" />
        <activity android:name=".ui.ComplainsActivity" android:exported="false" />
        <activity android:name=".ui.PrivacyPolicyActivity" android:exported="false" />
        <activity android:name=".ui.HelpActivity" android:exported="false" />
        <activity android:name=".ui.ContactActivity" android:exported="false" />
        <activity android:name=".ui.DevicesActivity" android:exported="false" />

        <receiver
            android:name=".util.ReminderReceiver"
            android:exported="false" />
    </application>

</manifest>
